# Keep source checkouts and source archives consistent with Ruff on Windows.
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
# Preserve the byte identity of versioned evaluation inputs across checkouts.
examples/injection-evaluation/*.json text eol=lf
tests/fixtures/document_multi_questions.json text eol=lf
tests/fixtures/documents/*.txt text eol=lf
docs/evaluations/b09-*.json text eol=lf

# This archived evaluation used CRLF bytes; preserve its historical hash.
tests/fixtures/documents/locking.txt -text
